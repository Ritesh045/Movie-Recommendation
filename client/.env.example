# CineSphere Frontend Environment Variables (Vercel / Local)

# Base URL pointing to the deployed Flask backend REST API on Render (or local dev server)
# Example Production: VITE_API_BASE_URL=https://cinesphere-api.onrender.com/api
# Example Local: VITE_API_BASE_URL=http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api
