# TMDB API Key for fetching real-time high quality poster images & extended metadata
# Optional: The app falls back to beautiful gradient placeholder posters if not set.
# Obtain a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Gemini API Key for CineBot AI Chatbot Integration
# Obtain key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

