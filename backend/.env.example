# CineSphere Backend REST API Environment Variables (Render / Local)

# TMDB API Key for fetching real-time high-resolution poster images & extended metadata
# Free key available at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Google Gemini API Key for CineBot AI Chatbot Integration
# Free key available at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Secret Key used to sign JWT authentication tokens (generate a strong random string)
JWT_SECRET_KEY=cinesphere-super-secret-jwt-key-2026-v1

# Port configuration (automatically assigned by Render in production)
PORT=5000
